{
  "name": "dsh-rugu",
  "version": "0.1.0-beta.0",
  "description": "DeepSeek Harness 插件「如故」：让 Agent 像一个真实存在的人——有独立的记忆，只有一段人生。别的记忆插件记的是「你」，如故记的是「她自己经历过什么」：QQ、DSH 桌面（以及别的入口）在场时经历的一切进同一份记忆，回话前像人一样想起一些，并自己判断在这里能不能说。DSH 设置里带管理页。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "persona",
    "rugu"
  ],
  "license": "MIT",
  "author": "QiuYeDx",
  "homepage": "https://github.com/QiuYeDx/dsh-rugu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QiuYeDx/dsh-rugu.git",
    "directory": "packages/dsh"
  },
  "bugs": {
    "url": "https://github.com/QiuYeDx/dsh-rugu/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./binding": "./src/binding/index.js",
    "./host": "./src/host/index.js",
    "./client": "./src/admin/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "scripts/bridge-whitelist-patch.mjs",
    "scripts/preset-config.mjs",
    "locale",
    "assets/icon.svg",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "rugu-core": "0.1.0-beta.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node ../../scripts/run-tests.mjs dsh",
    "plugin:install": "node scripts/install.mjs",
    "bridge:patch": "node scripts/bridge-whitelist-patch.mjs",
    "preset:config": "node scripts/preset-config.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "icon": "./assets/icon.svg"
}
